# Fork-specific — ignore generated eval reports — but not the directory itself, otherwise git
# won't descend into it and the negations below can't take effect.
eval/reports/*
# …except the Phase 2 acceptance evidence, which is a committed deliverable
# rather than a throwaway generated report.
!eval/reports/phase2/
eval/reports/phase2/*
!eval/reports/phase2/evidence.md
# …and the Phase 7 acceptance evidence, same deal.
!eval/reports/phase7/
eval/reports/phase7/*
!eval/reports/phase7/evidence.md
# …and the PHA-2732 rewrite acceptance harness evidence, same deal.
!eval/reports/rewriteAcceptance/
eval/reports/rewriteAcceptance/*
!eval/reports/rewriteAcceptance/evidence.md
eval/predictions*.json
eval/.env
.env

# Local-only eval material: captured roleplay transcripts and derived fixtures
# are not distributed with the repo. Recapture locally (see eval/README.md).
eval/fixtures/transcript.jsonl
eval/fixtures/transcript-markdown.md
eval/fixtures/worldbook.json
eval/fixtures/rewriteAcceptance-canned.json
eval/out/fixture.json
eval/out/fixture-md.json
eval/materials/stmb-auto/*.jsonl
eval/materials/stmb-auto/Magisa-_satire_fantasy_isekai_world.json
